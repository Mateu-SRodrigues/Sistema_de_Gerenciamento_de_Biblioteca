{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Compilar biblioteca (gcc)",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-g",
                "-Iinclude",
                "src/main.c",
                "src/menu.c",
                "src/livros.c",
                "src/usuarios.c",
                "src/emprestimos.c",
                "src/relatorios.c",
                "src/persistencia.c",
                "-o",
                "${workspaceFolder}/biblioteca.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila todos os módulos de src/ usando os headers de include/."
        }
    ]
}